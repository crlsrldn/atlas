ATLAS_ENV=local
ATLAS_BIND_ADDR=127.0.0.1:3000
ATLAS_PUBLIC_BASE_URL=http://127.0.0.1:3000
ATLAS_VAULT_MASTER_KEY=change-this-before-production

# Where the gateway reaches core, and where it reads global config from.
ATLAS_CORE_URL=http://127.0.0.1:3000
ATLAS_DASHBOARD_URL=http://127.0.0.1:5173

# Shared source cache. Optional: without it, each machine caches on its own.
UPSTASH_REDIS_URL=

# Jellyfin surface (Infuse Direct Mode). Off unless set, and no deployment
# sets it — nothing is mounted until you turn it on.
ATLAS_JELLYFIN_ENABLED=
# Development only. Logs every route a client asks for that Atlas does not
# serve, and answers 200 instead of 404 so one missing endpoint does not end a
# flow. Also falls back to the server's own preferences when the gateway is not
# in the path. Never set this in a deployment.
ATLAS_JELLYFIN_PERMISSIVE=

# Shown when a viewer picks a source TorBox has not cached yet.
#
# Selecting an uncached source queues it and there is nothing to play for
# roughly thirty seconds. Unset, the player receives a 503 and shows a generic
# failure, which reads as "this is broken" rather than "come back shortly".
# Point this at a short clip saying so and the wait explains itself.
#
# Any directly-playable URL works; it is handed to the player as a redirect, so
# it should be a small MP4 (H.264/AAC) on a CDN, not an HLS playlist.
ATLAS_PLACEHOLDER_VIDEO_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_CHECKOUT_URL=
